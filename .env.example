# Copiá este archivo a .env y ajustá los valores locales:
#   Copy-Item .env.example .env
# .env está en .gitignore y nunca debe versionarse. Este archivo solo
# contiene placeholders de desarrollo, no secretos reales.

# ============================
# PostgreSQL local (docker-compose.yml)
# ============================
# Deben coincidir con el servicio `postgres` del compose.
POSTGRES_DB=miralibros
POSTGRES_USER=miralibros
# Solo para desarrollo local. En producción usá un gestor de secretos.
POSTGRES_PASSWORD=miralibros

# ============================
# Conexión usada por el ETL
# ============================
# Puerto 5434 en el host porque el 5432 y el 5433 los ocupan otros proyectos
# locales; el compose lo publica como 5434:5432 (host:contenedor).
# Si cambiás POSTGRES_PASSWORD, actualizá también esta URL y URL-encodeá los
# caracteres especiales (por ejemplo `@` -> `%40`).
DATABASE_URL=postgresql://miralibros:miralibros@localhost:5434/miralibros

# Esquema donde vive la capa silver (etl/config.py valida el identificador).
PG_SCHEMA=silver

# ============================
# Privacidad de clientes
# ============================
# Clave HMAC-SHA256 para generar cliente_id a partir del RUT. En producción
# debe ser un secreto real y no versionarse. Cambiarla cambia todos los
# cliente_id ya calculados, por lo que la tabla de clientes debe regenerarse.
PII_HASH_KEY=miralibros-dev-pii-key
